<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow layer -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#80E94560"
                android:endColor="#40533483"
                android:angle="135" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- Main gradient -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#E94560"
                android:centerColor="#C73B5A"
                android:endColor="#533483"
                android:angle="135" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- Top highlight -->
    <item android:bottom="24dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#20FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:topLeftRadius="28dp" android:topRightRadius="28dp"
                android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
